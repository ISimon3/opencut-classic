{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCut",
  "version": "0.1.0",
  "identifier": "app.opencut.desktop",
  "build": {
    "beforeBuildCommand": "bun run desktop:prepare"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": { "../desktop-runtime/": "server/" },
    "windows": { "nsis": { "installMode": "currentUser", "compression": "zlib" } }
  }
}
